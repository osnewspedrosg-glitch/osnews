# Copy to azum-gemini/.env and keep that file out of git.
# These names are placeholders. Do not put a real key in the repository,
# the browser, or this example.

# closed (default) | mock | free
# mock never calls Google. free calls only gemini-2.5-flash after every gate below passes.
# paid is recognized and stays disabled. Do not set it.
AZUM_GEMINI_MODE=closed

# Local ledger cap in EUR. Default 30.00. Values above 30 are rejected.
# This counts calls from this process only. It is not a Google invoice cap.
AZUM_MONTHLY_BUDGET_EUR=30.00

# Required before mode=free will call Gemini. Keep this file out of git.
# AZUM_BUDGET_LEDGER=azum-gemini/ledger/budget.json

# API key from a Google AI Studio project whose tier you have verified as Free.
# A Gemini consumer Plus subscription is not an API key and is not API credit.
# GEMINI_API_KEY=

# Set to yes only after AI Studio shows this project on the Free tier.
GEMINI_FREE_TIER_CONFIRMED=no

# Must stay no. Linking billing moves the project to a paid tier. This bridge refuses yes.
GEMINI_BILLING_LINKED=no

# Operator region. EEA, Switzerland, the UK, and EU/EEA country codes keep the live path closed.
# Example of a non-EEA value you would set only if it is true: us
AZUM_OPERATOR_REGION=

# Shared password for this loopback bridge. Not the Gemini key. At least 16 characters.
AZUM_GATE_SECRET=

# Only gemini-2.5-flash is accepted. Any other value keeps the bridge closed.
GEMINI_MODEL=gemini-2.5-flash

# Listen address is forced to loopback. 0.0.0.0 is ignored and closes the live path.
AZUM_BIND=127.0.0.1
AZUM_PORT=8787

# Local caps, stricter than an unknown Google quota. Cannot be raised above 10 per minute or 50 per day.
AZUM_RPM=5
AZUM_RPD=30
